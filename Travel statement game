<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Statement sort: travel</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Kalam:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#fbfcfe; --line:#dde7f2; --margin:#f0a8a8; --ink:#1d2a3a; --soft:#56657a;
  --card:#ffffff; --edge:#c9d5e3;
  --support:#6ef06e; --challenge:#ff85ea; --neutral:#ffef4a;
  --red:#d62f2f; --tick:#1f8a3b;
  --hand:"Kalam","Comic Sans MS","Segoe Print",cursive;
  --body:"Atkinson Hyperlegible",Verdana,Tahoma,sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#18212c; --line:#243142; --margin:#5a2b33; --ink:#e7eef6; --soft:#a3b2c4;
    --card:#1f2a37; --edge:#33435a; --red:#ff6b6b; --tick:#5fd47f;
  }
}
:root[data-theme="dark"]{
  --paper:#18212c; --line:#243142; --margin:#5a2b33; --ink:#e7eef6; --soft:#a3b2c4;
  --card:#1f2a37; --edge:#33435a; --red:#ff6b6b; --tick:#5fd47f;
}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  margin:0;min-height:100%;color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.45;
  background-color:var(--paper);
  background-image:
    linear-gradient(90deg,transparent 54px,var(--margin) 54px,var(--margin) 56px,transparent 56px),
    repeating-linear-gradient(180deg,transparent 0 31px,var(--line) 31px 32px);
}
.wrap{max-width:1180px;margin:0 auto;padding:22px 20px 120px 72px}
@media (max-width:640px){.wrap{padding-left:20px} body{background-image:repeating-linear-gradient(180deg,transparent 0 31px,var(--line) 31px 32px)}}

h1{font-family:var(--hand);font-weight:700;font-size:clamp(2rem,4vw,2.8rem);line-height:1.1;margin:0 0 4px}
.task{margin:0 0 18px;color:var(--soft);max-width:70ch}

.quote{
  font-family:var(--body);font-style:italic;font-size:1.15rem;line-height:1.5;
  margin:0 0 22px;padding:14px 18px;border-left:5px solid var(--ink);background:var(--card);
  max-width:80ch;border-radius:0 6px 6px 0;box-shadow:0 1px 0 var(--edge);
}

/* highlighter pens */
.pens{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 20px;align-items:stretch}
.pen{
  font:inherit;color:var(--ink);background:var(--card);border:2px solid var(--edge);border-radius:10px;
  display:flex;align-items:center;gap:10px;padding:8px 14px 8px 8px;cursor:pointer;text-align:left;
  transition:transform .15s, border-color .15s;
}
.pen .nib{
  width:46px;height:30px;flex:none;background:var(--c);
  clip-path:polygon(0 0,72% 0,100% 50%,72% 100%,0 100%);border-radius:4px 0 0 4px;
}
.pen.erase .nib{background:repeating-linear-gradient(45deg,#e9eef4 0 6px,#cfd8e3 6px 12px)}
.pen b{display:block;font-size:1rem}
.pen small{display:block;color:var(--soft);font-size:.85rem;line-height:1.2}
.pen[aria-pressed="true"]{border-color:var(--ink);transform:translateY(-3px);box-shadow:0 3px 0 var(--ink)}
.pen kbd{font:inherit;font-size:.75rem;color:var(--soft);margin-left:4px}

/* cards */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(205px,1fr));gap:12px}
.card{
  position:relative;font:inherit;color:var(--ink);text-align:left;cursor:pointer;
  background:var(--card);border:1.5px solid var(--edge);border-radius:6px;
  padding:14px 14px 16px;min-height:150px;display:flex;flex-direction:column;gap:8px;
}
.card:hover{border-color:var(--soft)}
.txt{
  --hl:transparent;
  background-image:linear-gradient(176deg,transparent 4%,var(--hl) 4%,var(--hl) 94%,transparent 94%);
  background-repeat:no-repeat;background-size:0% 100%;
  -webkit-box-decoration-break:clone;box-decoration-break:clone;
  padding:.04em .18em;margin:0 -.18em;border-radius:3px;
  transition:background-size .45s ease-out;
}
.card[data-c] .txt{background-size:100% 100%;color:#1d2a3a}
.card[data-c="support"] .txt{--hl:var(--support)}
.card[data-c="challenge"] .txt{--hl:var(--challenge)}
.card[data-c="neutral"] .txt{--hl:var(--neutral)}

.why{display:none;font-size:.88rem;color:var(--soft);border-top:1px dashed var(--edge);padding-top:7px;margin-top:auto}
.checked .why{display:block}
.mark{
  position:absolute;top:-10px;right:-8px;width:34px;height:34px;border-radius:50%;
  display:none;place-items:center;font-family:var(--hand);font-weight:700;font-size:1.35rem;
  background:var(--card);border:2.5px solid currentColor;transform:rotate(-8deg);
}
.card.right .mark{display:grid;color:var(--tick)}
.card.wrong .mark{display:grid;color:var(--red)}
.card.wrong{border-color:var(--red)}

/* own ideas */
.own{cursor:default}
.own textarea{
  font:inherit;color:var(--ink);background:transparent;border:none;border-bottom:1.5px dashed var(--edge);
  resize:vertical;min-height:80px;width:100%;padding:2px 0;line-height:1.45;
}
.own textarea::placeholder{color:var(--soft)}
.own[data-c="support"] textarea{background:color-mix(in srgb,var(--support) 70%,transparent);color:#1d2a3a}
.own[data-c="challenge"] textarea{background:color-mix(in srgb,var(--challenge) 70%,transparent);color:#1d2a3a}
.own[data-c="neutral"] textarea{background:color-mix(in srgb,var(--neutral) 75%,transparent);color:#1d2a3a}
.own .hlbtn{font:inherit;font-size:.88rem;align-self:flex-start;background:none;border:1.5px solid var(--edge);color:var(--ink);border-radius:6px;padding:4px 10px;cursor:pointer}
.own .tag{font-family:var(--hand);font-size:1.05rem;color:var(--soft)}

/* bottom bar */
.bar{
  position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--card);border-top:2px solid var(--ink);
  padding:12px 20px calc(12px + env(safe-area-inset-bottom,0px));
}
.bar .in{max-width:1180px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;padding-left:52px}
@media (max-width:640px){.bar .in{padding-left:0}}
.status{flex:1 1 220px;font-family:var(--hand);font-size:1.25rem;line-height:1.2}
.btn{font:inherit;font-weight:700;border-radius:8px;padding:9px 16px;cursor:pointer;border:2px solid var(--ink);background:var(--card);color:var(--ink)}
.btn.main{background:var(--ink);color:var(--paper)}
.btn:disabled{opacity:.45;cursor:not-allowed}

:focus-visible{outline:3px solid #2f6fdc;outline-offset:3px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<main class="wrap">
  <h1>Statement sort: travel</h1>
  <p class="task">Pick a highlighter, then tap each statement to colour it. Does it support the statement below, challenge it, or is it neutral? When every card is coloured, check your answers.</p>

  <blockquote class="quote">‘People have become obsessed with travelling ever further and faster. However, travel is expensive, dangerous, damaging and a foolish waste of time!’</blockquote>

  <div class="pens" role="toolbar" aria-label="Highlighters">
    <button class="pen" data-pen="support" style="--c:var(--support)" aria-pressed="true"><span class="nib"></span><span><b>Supports <kbd>1</kbd></b><small>agrees travel is bad</small></span></button>
    <button class="pen" data-pen="challenge" style="--c:var(--challenge)" aria-pressed="false"><span class="nib"></span><span><b>Challenges <kbd>2</kbd></b><small>defends travel</small></span></button>
    <button class="pen" data-pen="neutral" style="--c:var(--neutral)" aria-pressed="false"><span class="nib"></span><span><b>Neutral <kbd>3</kbd></b><small>takes no side</small></span></button>
    <button class="pen erase" data-pen="erase" aria-pressed="false"><span class="nib"></span><span><b>Rubber <kbd>0</kbd></b><small>remove colour</small></span></button>
  </div>

  <section class="grid" id="grid" aria-label="Statements"></section>
</main>

<div class="bar">
  <div class="in">
    <div class="status" id="status" aria-live="polite"></div>
    <button class="btn main" id="check">Check answers</button>
    <button class="btn" id="reveal">Show answers</button>
    <button class="btn" id="reset">Start again</button>
  </div>
</div>

<script>
const S = [
  ["Travelling helps people see the world differently and understand perspectives they may never have considered before.","challenge","Defends travel against ‘a foolish waste of time’: it changes how you think."],
  ["Travellers face real risks, such as accidents, injuries or illnesses, especially in places where they don’t know the language or medical system.","support","Backs up ‘dangerous’."],
  ["Popular destinations often become overcrowded with tourists, which ruins the experience and puts pressure on local communities.","support","Backs up ‘damaging’ – to places and the people who live there."],
  ["Long‑distance flights and constant travel release large amounts of carbon emissions, which damage the environment.","support","Backs up ‘damaging’ – to the environment."],
  ["Flights, accommodation, insurance and visas quickly add up, making travel inaccessible for many people.","support","Backs up ‘expensive’."],
  ["Travelling can be extremely expensive, and many people spend far more than they can realistically afford.","support","Backs up ‘expensive’."],
  ["A break from everyday life can reduce stress and help people feel refreshed and more positive.","challenge","Argues travel is good for wellbeing, so not a waste of time."],
  ["Travelling creates long‑lasting memories that people treasure for years, making the experience meaningful even after the trip ends.","challenge","The value lasts after the trip, so not a waste of time."],
  ["Many countries rely heavily on tourism for jobs and economic development.","challenge","Argues travel helps countries rather than damaging them."],
  ["Some people travel for social media content rather than meaningful experiences, treating travel as a status symbol.","support","Backs up ‘obsessed’ and ‘a foolish waste of time’."],
  ["Faster travel allows people to visit remote places that were once inaccessible.","neutral","Describes ‘further and faster’ without saying it is good or bad."],
  ["Advances in technology, safety standards and navigation tools make international travel easier and less risky.","challenge","Argues against ‘dangerous’: travel is safer than claimed."],
  ["Exposure to different cultures fosters empathy, reduces prejudice, and increases global awareness.","challenge","Argues travel makes people – and the world – better."]
];
const NAMES = {support:"Supports",challenge:"Challenges",neutral:"Neutral"};
let pen = "support", checked = false, state = S.map(()=>null);

const grid = document.getElementById("grid");
const statusEl = document.getElementById("status");

function build(){
  grid.innerHTML = "";
  S.forEach((s,i)=>{
    const b = document.createElement("button");
    b.className = "card"; b.dataset.i = i;
    b.innerHTML = `<span class="mark" aria-hidden="true"></span><span><span class="txt"></span></span><span class="why"></span>`;
    b.querySelector(".txt").textContent = s[0];
    b.addEventListener("click",()=>paint(i));
    grid.appendChild(b);
  });
  for(let k=0;k<2;k++){
    const d = document.createElement("div");
    d.className = "card own";
    d.innerHTML = `<span class="tag">Your own idea</span><textarea aria-label="Your own idea ${k+1}" placeholder="Type a point for or against travel…"></textarea><button class="hlbtn" type="button">Highlight with current pen</button>`;
    d.querySelector(".hlbtn").addEventListener("click",()=>{
      if(pen==="erase" || d.dataset.c===pen) delete d.dataset.c; else d.dataset.c = pen;
    });
    grid.appendChild(d);
  }
  render();
}

function paint(i){
  const cur = state[i];
  state[i] = (pen==="erase" || cur===pen) ? null : pen;
  checked = false; revealed = false;
  render();
}

function render(){
  const cards = grid.querySelectorAll(".card:not(.own)");
  let done = 0, right = 0;
  cards.forEach((c,i)=>{
    const v = state[i];
    if(v){ c.dataset.c = v; done++; } else delete c.dataset.c;
    c.classList.remove("right","wrong","checked");
    const why = c.querySelector(".why"), mark = c.querySelector(".mark");
    const ok = v === S[i][1];
    if(ok) right++;
    if(checked){
      c.classList.add("checked", ok ? "right" : "wrong");
      mark.textContent = ok ? "✓" : "✗";
      why.textContent = ok ? S[i][2] : "Not quite – reread it. Does it attack travel, defend it, or take no side?";
      if(revealed) why.textContent = `${NAMES[S[i][1]]}: ${S[i][2]}`;
    }
    c.setAttribute("aria-label", `${S[i][0]} ${v ? "Highlighted: "+NAMES[v] : "Not highlighted"}${checked ? (ok?". Correct.":". Incorrect.") : ""}`);
  });
  document.getElementById("check").disabled = done < S.length;
  if(revealed){
    statusEl.textContent = "Answers shown – discuss: which points are strongest?";
  } else if(checked){
    statusEl.textContent = right === S.length
      ? `${right} / ${S.length} – every statement sorted correctly!`
      : `${right} / ${S.length} correct. Change the crossed cards and check again.`;
  } else {
    statusEl.textContent = done < S.length
      ? `${done} of ${S.length} statements highlighted`
      : `All ${S.length} highlighted – ready to check`;
  }
}

let revealed = false;
document.getElementById("check").addEventListener("click",()=>{ checked = true; revealed = false; render(); });
document.getElementById("reveal").addEventListener("click",()=>{
  state = S.map(s=>s[1]); checked = true; revealed = true; render();
});
document.getElementById("reset").addEventListener("click",()=>{
  state = S.map(()=>null); checked = false; revealed = false;
  grid.querySelectorAll(".own").forEach(d=>{ delete d.dataset.c; d.querySelector("textarea").value=""; });
  render();
});

const pens = document.querySelectorAll(".pen");
function setPen(p){ pen = p; pens.forEach(b=>b.setAttribute("aria-pressed", b.dataset.pen===p)); }
pens.forEach(b=>b.addEventListener("click",()=>setPen(b.dataset.pen)));
document.addEventListener("keydown",e=>{
  if(e.target.tagName==="TEXTAREA") return;
  const m = {"1":"support","2":"challenge","3":"neutral","0":"erase"}[e.key];
  if(m) setPen(m);
});

build();
</script>
</body>
</html>
